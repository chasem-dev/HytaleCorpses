$C = "../Common.ui";

// Dark dungeon color palette
@SectionBg = #141920;
@AccentGold = #c9a227;
@CorpseRed = #aa4444;

@SlotSize = 48;
@PanelWidth = 520;
@StorageWidth = 432;  // 9 slots * 48px each

$C.@PageOverlay {
  Background: #000000(0.7);
}

// Main container centered on screen
Group {
  Anchor: (Width: 1100, Height: 580);
  LayoutMode: Left;

  // ==========================================
  // LEFT PANEL - Player's Inventory
  // ==========================================
  $C.@DecoratedContainer #PlayerPanel {
    Anchor: (Width: @PanelWidth, Height: 580);

    #Title {
      Group {
        $C.@Title {
          @Text = "Your Inventory";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Horizontal: 16, Top: 8);

      // Unified dark background for all inventory sections
      Group {
        FlexWeight: 1;
        Background: @SectionBg;
        LayoutMode: Top;
        Padding: (Full: 12);

        // Armor Section Title
        Group {
          Anchor: (Height: 22);
          Padding: (Left: 4, Top: 4, Bottom: 6);

          Label {
            Text: "Equipped Armor";
            Style: (
              FontSize: 11,
              TextColor: @AccentGold,
              RenderUppercase: true,
              RenderBold: true,
              LetterSpacing: 1,
              VerticalAlignment: Center
            );
          }
        }

        // Armor Slots
        Group #PlayerArmorGrid {
          Anchor: (Height: @SlotSize);
          LayoutMode: Left;
          Padding: (Bottom: 8);
        }

        // Utility/Offhand Section Title
        Group {
          Anchor: (Height: 22);
          Padding: (Left: 4, Top: 4, Bottom: 6);

          Label {
            Text: "Off Hand";
            Style: (
              FontSize: 11,
              TextColor: @AccentGold,
              RenderUppercase: true,
              RenderBold: true,
              LetterSpacing: 1,
              VerticalAlignment: Center
            );
          }
        }

        // Utility/Offhand Slots
        Group #PlayerUtilityGrid {
          Anchor: (Height: @SlotSize);
          LayoutMode: Left;
          Padding: (Bottom: 16);
        }

        // Storage Section Title
        Group {
          Anchor: (Height: 22);
          Padding: (Left: 4, Top: 8, Bottom: 6);

          Label {
            Text: "Storage";
            Style: (
              FontSize: 11,
              TextColor: @AccentGold,
              RenderUppercase: true,
              RenderBold: true,
              LetterSpacing: 1,
              VerticalAlignment: Center
            );
          }
        }

        // Storage Slots
        Group #PlayerStorageGrid {
          Anchor: (Width: @StorageWidth, Height: 192);
          LayoutMode: LeftCenterWrap;
          Padding: (Bottom: 16);
        }

        // Hotbar Section Title
        Group {
          Anchor: (Height: 22);
          Padding: (Left: 4, Top: 8, Bottom: 6);

          Label {
            Text: "Hotbar";
            Style: (
              FontSize: 11,
              TextColor: @AccentGold,
              RenderUppercase: true,
              RenderBold: true,
              LetterSpacing: 1,
              VerticalAlignment: Center
            );
          }
        }

        // Hotbar Slots
        Group #PlayerHotbarGrid {
          Anchor: (Height: @SlotSize);
          LayoutMode: Left;
        }
      }
    }
  }

  // ==========================================
  // CENTER DIVIDER
  // ==========================================
  Group {
    Anchor: (Width: 60);
    LayoutMode: CenterMiddle;

    Group {
      Anchor: (Width: 60, Height: 60);
      LayoutMode: Top;

      Label {
        Anchor: (Height: 24);
        Text: "<<<";
        Style: (
          FontSize: 14,
          TextColor: #5a6570,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }

      Label {
        Anchor: (Height: 24);
        Text: ">>>";
        Style: (
          FontSize: 14,
          TextColor: #5a6570,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
      }
    }
  }

  // ==========================================
  // RIGHT PANEL - Corpse's Inventory
  // ==========================================
  $C.@DecoratedContainer #CorpsePanel {
    Anchor: (Width: @PanelWidth, Height: 580);

    #Title {
      Group {
        $C.@Title #TitleLabel {
          @Text = "Corpse";
        }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Horizontal: 16, Top: 8);

      // Unified dark background for all inventory sections
      Group {
        FlexWeight: 1;
        Background: @SectionBg;
        LayoutMode: Top;
        Padding: (Full: 12);

        // Armor Section Title
        Group {
          Anchor: (Height: 22);
          Padding: (Left: 4, Top: 4, Bottom: 6);

          Label {
            Text: "Equipped Armor";
            Style: (
              FontSize: 11,
              TextColor: @CorpseRed,
              RenderUppercase: true,
              RenderBold: true,
              LetterSpacing: 1,
              VerticalAlignment: Center
            );
          }
        }

        // Armor Slots
        Group #CorpseArmorGrid {
          Anchor: (Height: @SlotSize);
          LayoutMode: Left;
          Padding: (Bottom: 8);
        }

        // Utility/Offhand Section Title
        Group {
          Anchor: (Height: 22);
          Padding: (Left: 4, Top: 4, Bottom: 6);

          Label {
            Text: "Off Hand";
            Style: (
              FontSize: 11,
              TextColor: @CorpseRed,
              RenderUppercase: true,
              RenderBold: true,
              LetterSpacing: 1,
              VerticalAlignment: Center
            );
          }
        }

        // Utility/Offhand Slots
        Group #CorpseUtilityGrid {
          Anchor: (Height: @SlotSize);
          LayoutMode: Left;
          Padding: (Bottom: 16);
        }

        // Storage Section Title
        Group {
          Anchor: (Height: 22);
          Padding: (Left: 4, Top: 8, Bottom: 6);

          Label {
            Text: "Storage";
            Style: (
              FontSize: 11,
              TextColor: @CorpseRed,
              RenderUppercase: true,
              RenderBold: true,
              LetterSpacing: 1,
              VerticalAlignment: Center
            );
          }
        }

        // Storage Slots
        Group #CorpseStorageGrid {
          Anchor: (Width: @StorageWidth, Height: 192);
          LayoutMode: LeftCenterWrap;
          Padding: (Bottom: 16);
        }

        // Hotbar Section Title
        Group {
          Anchor: (Height: 22);
          Padding: (Left: 4, Top: 8, Bottom: 6);

          Label {
            Text: "Hotbar";
            Style: (
              FontSize: 11,
              TextColor: @CorpseRed,
              RenderUppercase: true,
              RenderBold: true,
              LetterSpacing: 1,
              VerticalAlignment: Center
            );
          }
        }

        // Hotbar Slots
        Group #CorpseHotbarGrid {
          Anchor: (Height: @SlotSize);
          LayoutMode: Left;
        }
      }
    }
  }
}

$C.@BackButton {}
